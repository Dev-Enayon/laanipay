# LaaniPay web — environment variables
# Copy to .env and fill in real values. Never commit .env.

# Backend API base URL (Express API). For local dev:
VITE_API_URL=http://localhost:5000/api

# Paystack PUBLIC key — the only Paystack credential allowed in the frontend.
# NEVER put the secret key here.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
