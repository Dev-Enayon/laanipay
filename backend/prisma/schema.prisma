// LaaniPay Ecosystem — Prisma schema
// Database: Neon (serverless Postgres) via pooled connection string (DATABASE_URL).
// Driver adapter: @prisma/adapter-neon (see src/lib/prisma.js).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  fullName         String   @map("full_name")
  email            String   @unique
  phone            String
  passwordHash     String   @map("password_hash")
  activationStatus         Boolean   @default(false) @map("activation_status")
  referralCode             String    @unique @default(cuid()) @map("referral_code")
  emailVerifiedAt          DateTime? @map("email_verified_at")
  verificationToken        String?   @unique @map("verification_token")
  verificationTokenExpiry  DateTime? @map("verification_token_expiry")
  role                     String    @default("user")
  status                   String    @default("active")
  suspendedAt              DateTime? @map("suspended_at")
  suspendedBy              String?   @map("suspended_by")
  suspendedReason          String?   @map("suspended_reason")
  reactivatedAt            DateTime? @map("reactivated_at")
  reactivatedBy            String?   @map("reactivated_by")
  lastActivityAt           DateTime? @map("last_activity_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  // Paystack Customer code used for Dedicated Virtual Account provisioning and
  // for matching incoming bank-transfer deposits. Unique (nullable) so a
  // charge.success webhook can be attributed to exactly one user.
  paystackCustomerCode     String?   @unique @map("paystack_customer_code")

  wallet                   Wallet?
  activationPayments       ActivationPayment[]
  downline                 MlmReferral[] @relation("Referrer")
  placement                MlmReferral[] @relation("ReferredUser")
  mlmRanks                 MlmRank[]
  contributionSubscriptions ContributionSubscription[]
  cohortMemberships        CohortMember[]
  receivedPayouts          Payout[]
  referralRewards          ReferralReward[] @relation("RewardRecipient")
  referralRewardsGiven     ReferralReward[] @relation("RewardSource")
  auditLogs                AuditLog[] @relation("UserLogs")
  adminLogs                AuditLog[] @relation("AdminActions")
  targetLogs               AuditLog[] @relation("TargetedUser")
  walletTransactions       WalletTransaction[]
  withdrawals              Withdrawal[]
  companyLedger            CompanyLedger[]
  serviceCharges           ServiceCharge[]
  notifications            Notification[] @relation("DirectUserNotifications")
  sentNotifications        Notification[] @relation("SentNotifications")
  notificationReceipts     NotificationReceipt[]
  virtualAccounts          VirtualAccount[]
  walletDeposits           WalletDeposit[]
  transferRecipients       PaystackTransferRecipient[]
  bufferLedger             BufferLedger[]
  missedContributions      MissedContribution[]
  defaultCases             ContributionDefault[]
  fines                    ContributionFine[]
  deathCases               DeathCase[]
  guaranteedBy             Guarantor[] @relation("GuaranteedUser")
  guarantees               Guarantor[] @relation("GuarantorUser")

  @@index([status])
  @@map("users")
}

model Wallet {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  balance          Int      @default(0)
  heldBalance      Int      @default(0) @map("held_balance")
  totalContributed Int      @default(0) @map("total_contributed")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model ActivationPayment {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  paystackReference String   @unique @map("paystack_reference")
  amount           Int
  status           String    @default("pending")
  verifiedAt       DateTime? @map("verified_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("activation_payments")
}

model MlmReferral {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  referrerId  String?  @map("referrer_id")
  level       Int
  bonusEarned Int      @default(0) @map("bonus_earned")
  createdAt   DateTime @default(now()) @map("created_at")

  user     User  @relation("ReferredUser", fields: [userId], references: [id], onDelete: Cascade)
  referrer User? @relation("Referrer", fields: [referrerId], references: [id], onDelete: SetNull)

  @@unique([userId, referrerId, level])
  @@index([referrerId])
  @@index([userId])
  @@map("mlm_referrals")
}

model MlmRank {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  rank       String
  achievedAt DateTime @default(now()) @map("achieved_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mlm_ranks")
}

model ContributionPlan {
  id            String   @id @default(cuid())
  name          String
  // MONTHLY plans are billed/paid by their monthly_amount (the original,
  // preserved model). WEEKLY plans are the added AJO frequency and use
  // weekly_amount + cycleWeeks. Each frequency occupies its own amount column;
  // the other column is NULL (no repurposing of monthly_amount for weekly).
  frequency     String   @default("MONTHLY") // MONTHLY | WEEKLY
  monthlyAmount Int?     @map("monthly_amount")
  weeklyAmount  Int?     @map("weekly_amount")
  cycleWeeks    Int      @default(52) @map("cycle_weeks")
  createdAt     DateTime @default(now()) @map("created_at")

  subscriptions ContributionSubscription[]
  cohorts        Cohort[]
  payouts        Payout[]

  @@unique([name, frequency])
  @@index([frequency])
  @@map("contribution_plans")
}

model ContributionSubscription {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  planId          String   @map("plan_id")
  cohortId        String?  @map("cohort_id")
  status          String   @default("active")
  // Snapshot of the amount owed per contribution period, captured when the
  // subscription is created (and backfilled for existing subscriptions when
  // monthly tiers change). Payment amount = `amountKobo ?? planAmount(plan)`,
  // so a pre-existing subscription keeps its original financial terms even if
  // the plan's tier is later updated. Weekly subscriptions carry their
  // weekly_amount here; the weekly amounts are unchanged by tier updates.
  amountKobo      Int?     @map("amount_kobo")
  nextPaymentDate DateTime @map("next_payment_date")
  createdAt       DateTime @default(now()) @map("created_at")

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     ContributionPlan      @relation(fields: [planId], references: [id])
  cohort   Cohort?               @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  payments ContributionPayment[]

  @@index([userId])
  @@map("contribution_subscriptions")
}

model ContributionPayment {
  id                String    @id @default(cuid())
  subscriptionId    String    @map("subscription_id")
  paystackReference String    @unique @map("paystack_reference")
  amount            Int
  status            String    @default("pending")
  weekIndex         Int?      @map("week_index")
  cohortId          String?   @map("cohort_id")
  paidAt            DateTime? @map("paid_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  // Security-buffer split of the ACTUAL paid `amount` (NULL for rows created
  // before the buffer fund existed — treated as 100% main). The accounting
  // invariant `mainAmount + bufferAmount === amount` is enforced by the
  // buffer math (lib/bufferFund.js), not by the database.
  mainAmount   Int?   @map("main_amount")
  bufferAmount Int?   @map("buffer_amount")

  subscription ContributionSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  bufferLedger BufferLedger[]
  // When this payment is a catch-up, these record how the total was split:
  // missedKobo (restores advanced buffer first), currentKobo (normal period),
  // fineKobo (assessed fine). They must sum to `amount` — the catch-up
  // allocation is verified against the real payment, never invented.
  missedKobo  Int?     @map("missed_kobo")
  currentKobo Int?     @map("current_kobo")
  fineKobo    Int?     @map("fine_kobo")
  kind        String?  // regular | catchup
  caughtUpMissed MissedContribution[] @relation("CaughtUpPayment")

  @@index([subscriptionId])
  @@map("contribution_payments")
}

// Security-buffer contribution fund for weekly AJO cohorts. A configurable
// share of each verified weekly contribution is diverted from the member's
// main contribution into the group's buffer pool, tracked per (cohort, user).
// This is the BUFFER FUND FOUNDATION ONLY: crediting on verified payments is
// wired; default/death/fine/recovery flows that would DEBIT the buffer are
// deliberately NOT implemented here (see lib/bufferFund.js and the recovery
// plan). The ledger carries every movement and a balance is derived from it
// (signed sum) — no stored balance column, so there is no second book that can
// drift. `amount_kobo` is always positive; `sign` (+1/−1) carries direction.
model BufferLedger {
  id         String    @id @default(cuid())
  cohortId   String    @map("cohort_id")
  userId     String    @map("user_id")
  eventType  String    @map("event_type") // BUFFER_CREDIT | BUFFER_DEBIT | BUFFER_REFUND | BUFFER_ADJUSTMENT
  amountKobo Int       @map("amount_kobo")
  sign       Int       @default(1) // +1 credits the pool, -1 debits/refunds the pool
  reference  String    @unique // idempotency key (e.g. "buffer:{paystack reference}")
  reason     String?
  actor      String    @default("system") // system | admin:{adminId}
  paymentId  String?   @map("payment_id")
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at")

  cohort  Cohort                @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment ContributionPayment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([cohortId, userId])
  @@index([cohortId, createdAt])
  @@map("buffer_ledger")
}

// A scheduled weekly contribution the member did not pay in time. This is the
// RECORD of the miss — it is created the moment a week is detected unpaid and
// is never silently deleted. `status` carries the missed-contribution state
// machine (MISSED → GRACE → CAUGHT_UP | DEFAULTED); a CAUGHT_UP row links the
// catch-up payment that settled it. The unique (cohortId, memberId, weekIndex)
// makes detection idempotent — a week can only be recorded as missed once.
model MissedContribution {
  id          String    @id @default(cuid())
  cohortId    String    @map("cohort_id")
  memberId    String    @map("member_id")
  userId      String    @map("user_id")
  weekIndex   Int       @map("week_index")
  // The contribution amount that went unpaid, in kobo, plus how much of it was
  // security buffer (informational: a missed payment credits no buffer).
  amountKobo  Int       @map("amount_kobo")
  bufferAmountKobo Int   @default(0) @map("buffer_amount_kobo")
  dueAt       DateTime  @map("due_at")
  status      String    @default("MISSED") // MISSED | GRACE | CAUGHT_UP | DEFAULTED
  graceEndsAt DateTime? @map("grace_ends_at")
  resolvedAt  DateTime? @map("resolved_at")
  // Idempotency key for the detection sweep: "miss:{cohortId}:{memberId}:{week}".
  reference   String    @unique
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  cohort          Cohort                @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  member          CohortMember          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  caughtUpPayment ContributionPayment?  @relation("CaughtUpPayment", fields: [caughtUpPaymentId], references: [id], onDelete: SetNull)
  caughtUpPaymentId String?             @map("caught_up_payment_id")
  defaultCase     ContributionDefault?

  @@unique([cohortId, memberId, weekIndex])
  @@index([userId, status])
  @@index([cohortId, status])
  @@map("missed_contributions")
}

// The recovery case opened when a member's grace expires without a catch-up
// (or when a death case requires financial review). This is the durable record
// of a default: nothing is ever deleted, only advanced through `status`.
// Money is tracked in parts and never conflated:
//   outstandingKobo  = missedKobo + fineKobo (+ any explicitly approved charge)
//   bufferUsedKobo   = how much of the group's buffer was advanced to protect
//                      the group's payout obligation on this member's behalf
//   shortfallKobo    = protection that was REQUIRED but the buffer could not
//                      cover (BUFFER_INSUFFICIENT) — an UNRESOLVED obligation
//                      surfaced to admin, never silently written off
model ContributionDefault {
  id          String    @id @default(cuid())
  cohortId    String    @map("cohort_id")
  memberId    String    @map("member_id")
  userId      String    @map("user_id")
  // One open case per (cohort, member) at a time; `reference` is the global
  // idempotency key for case creation ("default:{cohortId}:{memberId}:{week}").
  weekIndex   Int?      @map("week_index")
  reference   String    @unique
  status      String    @default("OPEN") // OPEN | CONTACTING | PROMISED | PARTIALLY_RECOVERED | RECOVERED | ESCALATED | CLOSED
  missedKobo  Int       @default(0) @map("missed_kobo")
  fineKobo    Int       @default(0) @map("fine_kobo")
  bufferUsedKobo Int    @default(0) @map("buffer_used_kobo")
  // Required protection vs what the buffer could actually give. Non-zero means
  // the group absorbed a shortfall that has NOT been resolved by any rule yet.
  shortfallKobo Int     @default(0) @map("shortfall_kobo")
  recoveredKobo Int     @default(0) @map("recovered_kobo")
  outstandingKobo Int    @default(0) @map("outstanding_kobo")
  contactAttempts Int    @default(0) @map("contact_attempts")
  lastContactAt DateTime? @map("last_contact_at")
  promisedAt   DateTime? @map("promised_at")
  promisedKobo Int?      @map("promised_kobo")
  guarantorId  String?   @map("guarantor_id")
  adminNotes   String?   @map("admin_notes")
  closedAt     DateTime? @map("closed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  cohort   Cohort       @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  member   CohortMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  guarantor Guarantor?  @relation(fields: [guarantorId], references: [id], onDelete: SetNull)
  missed   MissedContribution? @relation(fields: [missedContributionId], references: [id], onDelete: SetNull)
  missedContributionId String? @unique @map("missed_contribution_id")
  fines    ContributionFine[]
  deathCase DeathCase?

  @@index([userId, status])
  @@index([cohortId, status])
  @@index([status])
  @@map("contribution_defaults")
}

// A default fine is its OWN financial event, never folded silently into a
// balance. `amountKobo` comes from the configurable fine policy (never
// hard-coded) and is zero while fines are disabled. `reference` is unique so a
// retry can never charge the same fine twice. `destination` records where the
// money goes when collected; it is a LABEL only — no automatic transfer is
// performed by this layer.
model ContributionFine {
  id          String    @id @default(cuid())
  defaultId   String    @map("default_id")
  cohortId    String    @map("cohort_id")
  userId      String    @map("user_id")
  amountKobo  Int       @map("amount_kobo")
  reason      String?
  reference   String    @unique // "fine:{defaultId}" — one fine per case
  destination String    @default("unassigned") // label only; see ContributionFine
  status      String    @default("ASSESSED") // ASSESSED | WAIVED | COLLECTED | CANCELLED
  collectedPaymentId String? @map("collected_payment_id")
  collectedAt DateTime? @map("collected_at")
  waivedReason String?  @map("waived_reason")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  defaultCase ContributionDefault @relation(fields: [defaultId], references: [id], onDelete: Cascade)
  cohort      Cohort              @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([cohortId])
  @@map("contribution_fines")
}

// Death is a SEPARATE workflow, never a plain default. The state machine is
// DEATH_REPORTED → DEATH_VERIFICATION → VERIFIED_DECEASED → PARTICIPATION_CLOSED
// → FINANCIAL_REVIEW → ESTATE_RESOLUTION. This model records the workflow,
// evidence and the money picture; it NEVER charges the family, NEVER debits a
// guarantor, and NEVER promises buffer coverage. `estateDetermination` stays
// 'UNRESOLVED' until a human sets the accounting treatment.
model DeathCase {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  cohortId    String?   @map("cohort_id")
  defaultId   String?   @unique @map("default_id")
  reference   String    @unique
  status      String    @default("DEATH_REPORTED")
  reportedBy  String?   @map("reported_by")
  reportedAt  DateTime  @default(now()) @map("reported_at")
  verificationReference String? @map("verification_reference")
  verifiedAt  DateTime? @map("verified_at")
  // Evidence is a REFERENCE/pointer only (document id or admin-uploaded ref).
  // No identity documents are stored by this layer.
  verificationEvidence  String? @map("verification_evidence")
  participationClosedAt DateTime? @map("participation_closed_at")
  financialReviewedAt   DateTime? @map("financial_reviewed_at")
  // The money picture as at review, all in kobo. These are FACTS read from the
  // ledger, not charges.
  paidContributionsKobo Int @default(0) @map("paid_contributions_kobo")
  payoutStatus   String? @map("payout_status")
  outstandingKobo Int    @default(0) @map("outstanding_kobo")
  bufferUsedKobo  Int    @default(0) @map("buffer_used_kobo")
  // Amount determinable as due to/from the estate. NULL = not determined; the
  // system does not guess and does not auto-charge anyone.
  estateDueKobo   Int?   @map("estate_due_kobo")
  // UNRESOLVED | WAIVED | PAYABLE_BY_ESTATE | NOT_DETERMINABLE — set by a human.
  estateDetermination String @default("UNRESOLVED") @map("estate_determination")
  adminNotes   String?   @map("admin_notes")
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort  Cohort?               @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  defaultCase ContributionDefault? @relation(fields: [defaultId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status])
  @@map("death_cases")
}

// A guarantor is a RECORDED REFERENCE for a documented recovery workflow only.
// It carries no automatic financial liability: nothing in this codebase debits,
// charges, or holds funds against a guarantor. `liabilityAcknowledged` stays
// false until a human explicitly records that the guarantor has accepted
// responsibility in writing.
model Guarantor {
  id         String    @id @default(cuid())
  userId     String    @map("user_id") // the member being covered
  // The guarantor may be another platform user OR an off-platform person
  // recorded by name/phone only. Off-platform personal data is never exposed
  // to ordinary users — only admins can read it.
  linkedUserId String? @map("linked_user_id")
  fullName    String    @map("full_name")
  phone       String?
  relationship String?
  reference   String?   @map("reference")
  liabilityAcknowledged Boolean @default(false) @map("liability_acknowledged")
  acknowledgedAt DateTime? @map("acknowledged_at")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user       User                  @relation("GuaranteedUser", fields: [userId], references: [id], onDelete: Cascade)
  linkedUser User?                 @relation("GuarantorUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  defaultCases ContributionDefault[]

  @@index([userId])
  @@map("guarantors")
}

// Platform configuration — admin-editable key/value store used for financial
// rules (fees, rewards, cohort size, etc.). Values are stored as JSON so they
// can be tuned at runtime without deploys.
model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json?
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("platform_settings")
}

// 3-level referral reward ledger. One row per (recipient, level, source).
// The sum of rewards for a source never exceeds its payment amount — whatever
// is left over is implicitly company revenue. `reference` is unique so a
// repeated credit (webhook retry, scheduler re-run) can never double-pay.
model ReferralReward {
  id           String    @id @default(cuid())
  type         String    // REGISTRATION | MONTHLY_SUBSCRIPTION | WEEKLY_CONTRIBUTION
  userId       String    @map("user_id") // reward recipient (upline)
  sourceUserId String    @map("source_user_id") // user whose payment earned the reward
  level        Int
  amountKobo   Int       @map("amount_kobo")
  reference    String    @unique
  status       String    @default("earned") // earned | paid
  createdAt    DateTime  @default(now()) @map("created_at")
  paidAt       DateTime? @map("paid_at")

  user       User @relation("RewardRecipient", fields: [userId], references: [id], onDelete: Cascade)
  sourceUser User @relation("RewardSource", fields: [sourceUserId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sourceUserId, type])
  @@map("referral_rewards")
}

// Weekly AJO (rotating savings) cohort. Exactly `size` positions (default 52).
// New members take the lowest free position; when full the cohort becomes ACTIVE
// and a weekly cycle begins in which position N collects the week N pool.
model Cohort {
  id          String    @id @default(cuid())
  name        String
  planId      String    @map("plan_id")
  size        Int       @default(52)
  status      String    @default("RECRUITING") // RECRUITING | ACTIVE | COMPLETED
  currentWeek Int       @default(1) @map("current_week")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  lastAdvancedAt DateTime? @map("last_advanced_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  plan    ContributionPlan @relation(fields: [planId], references: [id])
  members CohortMember[]
  payouts Payout[]
  subscriptions ContributionSubscription[]
  bufferLedger BufferLedger[]
  missedContributions MissedContribution[]
  defaultCases ContributionDefault[]
  fines ContributionFine[]
  deathCases DeathCase[]

  @@index([planId, status])
  @@map("cohorts")
}

model CohortMember {
  id           String    @id @default(cuid())
  cohortId     String    @map("cohort_id")
  userId       String    @map("user_id")
  position     Int
  status       String    @default("ACTIVE") // ACTIVE | COLLECTED | WAIVED | LEFT | DEFAULTED
  // The missed-contribution state machine for THIS member in THIS cohort. Kept
  // as a field on the existing CohortMember row rather than a parallel status
  // system: ACTIVE → PAYMENT_MISSED → GRACE → CAUGHT_UP | DEFAULTED. `status`
  // above remains the participation lifecycle; `defaultStatus` is the
  // delinquency track that decides whether participation is closed.
  defaultStatus String  @default("ACTIVE") @map("default_status")
  totalPaid    Int       @default(0) @map("total_paid")
  lastPaidWeek Int?      @map("last_paid_week")
  collectedWeek Int?     @map("collected_week")
  joinedAt     DateTime  @default(now()) @map("joined_at")
  closedAt     DateTime? @map("closed_at")
  closedReason String?   @map("closed_reason")

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts Payout[]
  missedContributions MissedContribution[]
  defaultCases ContributionDefault[]

  @@unique([cohortId, position])
  @@unique([cohortId, userId])
  @@index([userId])
  @@index([cohortId, defaultStatus])
  @@map("cohort_members")
}

// A weekly payout to the week's collector. Unique (cohort, weekIndex) makes
// processing idempotent. `provider` distinguishes internal wallet settlement
// ('internal') from an external bank transfer ('paystack_transfer' / 'manual')
// so the limitation is explicit, not hidden.
model Payout {
  id                String    @id @default(cuid())
  cohortId          String    @map("cohort_id")
  cohortMemberId    String    @map("cohort_member_id")
  userId            String    @map("user_id")
  planId            String    @map("plan_id")
  weekIndex         Int       @map("week_index")
  grossAmount       Int       @map("gross_amount")
  platformFee       Int       @default(0) @map("platform_fee")
  netAmount         Int       @default(0) @map("net_amount")
  status            String    @default("PROCESSING") // PROCESSING | PAID | FAILED | SKIPPED
  provider          String    @default("internal")
  providerReference String?   @map("provider_reference")
  // Security-buffer protection for this week. `gross_amount`/`net_amount` stay
  // the REAL collected pot figures; the buffer advance is tracked here and in
  // the buffer ledger so the pot and the platform fee are never inflated.
  // `protectionShortfallKobo` > 0 means the buffer could not cover the
  // obligation (BUFFER_INSUFFICIENT) and the shortfall is UNRESOLVED.
  protectedFromBufferKobo Int @default(0) @map("protected_from_buffer_kobo")
  protectionShortfallKobo Int @default(0) @map("protection_shortfall_kobo")
  processedAt       DateTime? @map("processed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  cohort       Cohort           @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  cohortMember CohortMember     @relation(fields: [cohortMemberId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         ContributionPlan @relation(fields: [planId], references: [id])

  @@unique([cohortId, weekIndex])
  @@index([userId])
  @@index([status])
  @@map("payouts")
}

// Webhook activity log. Every Paystack event is persisted for audit and
// idempotency; the unique (provider, event, reference) constraint makes retries
// harmless.
model WebhookEvent {
  id        String    @id @default(cuid())
  provider  String    @default("paystack")
  event     String
  reference String?
  status    String    @default("RECEIVED") // RECEIVED | PROCESSED | FAILED | IGNORED
  message   String?
  body      Json?
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([provider, event, reference])
  @@index([reference])
  @@index([createdAt])
  @@map("webhook_events")
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  adminId      String?  @map("admin_id")
  targetUserId String?  @map("target_user_id")
  action       String
  reason       String?
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  user       User? @relation("UserLogs", fields: [userId], references: [id], onDelete: SetNull)
  adminUser  User? @relation("AdminActions", fields: [adminId], references: [id], onDelete: SetNull)
  targetUser User? @relation("TargetedUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([adminId])
  @@index([targetUserId])
  @@map("audit_logs")
}

// Wallet ledger — every credit/debit against a user's wallet (contributions,
// MLM bonuses, manual admin deposits/withdrawals/adjustments).
model WalletTransaction {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  type         String
  amount       Int
  balanceAfter Int      @default(0) @map("balance_after")
  status       String   @default("completed")
  reference    String?
  description  String?
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("wallet_transactions")
}

// A Paystack Dedicated Virtual Account (DVA) provisioned for a user so they
// can fund their LaaniPay wallet via a plain bank transfer. A user has at most
// one ACTIVE virtual account; re-provisioning marks older rows INACTIVE.
// `account_number` is unique so a Paystack NUBAN can never be double-recorded.
model VirtualAccount {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  // Paystack DVA id from the dedicated_account object (numeric id as string).
  paystackDvaId String?   @unique @map("paystack_dva_id")
  customerCode  String    @map("customer_code")
  accountNumber String?   @unique @map("account_number")
  accountName   String?   @map("account_name")
  bankName      String?   @map("bank_name")
  bankSlug      String?   @map("bank_slug")
  currency      String    @default("NGN")
  status        String    @default("ACTIVE") // ACTIVE | INACTIVE | FAILED
  assignedAt    DateTime? @map("assigned_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  deposits  WalletDeposit[]

  @@index([userId, status])
  @@map("virtual_accounts")
}

// Idempotency record for wallet funding from a DVA bank transfer. `reference`
// holds the Paystack transaction reference from charge.success and is UNIQUE,
// so a replayed or duplicated webhook can never credit the wallet twice.
model WalletDeposit {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  reference        String    @unique // Paystack transaction reference
  transactionId    String?   @unique @map("transaction_id") // Paystack numeric tx id
  customerCode     String?   @map("customer_code")
  virtualAccountId String?   @map("virtual_account_id")
  amountKobo       Int       @map("amount_kobo")
  currency         String    @default("NGN")
  status           String    @default("verified") // verified | failed
  createdAt        DateTime  @default(now()) @map("created_at")

  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  virtualAccount VirtualAccount? @relation(fields: [virtualAccountId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("wallet_deposits")
}

// Wallet withdrawal requests. Funds are reserved atomically at request time
// (balance -> heldBalance) so a withdrawal can never drive the available
// balance negative. External bank transfers (Paystack) are provider-gated:
// when the provider is disabled a request stays PENDING / PROCESSING and is
// settled through the admin-verified payout flow; SUCCESS is only ever marked
// by an admin verification or a confirmed provider event, never faked.
// `activeLock` (unique, null when inactive) guarantees at most one active
// (PENDING/PROCESSING) withdrawal per user even under concurrency.
model Withdrawal {
  id                       String    @id @default(cuid())
  userId                   String    @map("user_id")
  amountKobo               Int       @map("amount_kobo")
  status                   String    @default("PENDING") // PENDING | PROCESSING | SUCCESS | FAILED | REVERSED | CANCELLED
  provider                 String    @default("internal") // internal | paystack_transfer
  providerReference        String?   @unique @map("provider_reference")
  bankName                 String?   @map("bank_name")
  bankCode                 String?   @map("bank_code")
  accountNumber            String?   @map("account_number")
  accountName              String?   @map("account_name")
  failureReason            String?   @map("failure_reason")
  notes                    String?
  reservedAt               DateTime? @map("reserved_at")
  processedAt              DateTime? @map("processed_at")
  completedAt              DateTime? @map("completed_at")
  cancelledAt              DateTime? @map("cancelled_at")
  walletTransactionId      String?   @unique @map("wallet_transaction_id")
  refundedWalletTransactionId String? @unique @map("refunded_wallet_transaction_id")
  processedByAdminId       String?   @map("processed_by_admin_id")
  activeLock               String?   @unique @map("active_lock")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("withdrawals")
}

// Persisted Paystack NUBAN transfer recipients. Reusing an existing recipient
// (instead of creating a fresh one per withdrawal) avoids duplicate recipients
// on the Paystack account and keeps the recipient_code traceable.
model PaystackTransferRecipient {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  recipientCode String   @unique @map("recipient_code")
  bankCode      String   @map("bank_code")
  accountNumber String   @map("account_number")
  accountName   String   @map("account_name")
  currency      String   @default("NGN")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("paystack_transfer_recipients")
}

// Company ledger — recorded platform expenses and revenue adjustments.
// Used with activation fees and MLM bonuses to compute true company profit.
model CompanyLedger {
  id          String   @id @default(cuid())
  type        String
  amount      Int
  description String?
  adminId     String?  @map("admin_id")
  createdAt   DateTime @default(now()) @map("created_at")

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("company_ledger")
}

// Monthly ₦500 service charge deducted from each eligible user's wallet.
// One row per user per billing month (billingMonth = 'YYYY-MM'), unique
// constraint guarantees a user can never be charged twice for the same month.
model ServiceCharge {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  amountKobo   Int      @map("amount_kobo")
  currency     String   @default("NGN")
  billingMonth String   @map("billing_month") // 'YYYY-MM'
  status       String   @default("collected") // collected | insufficient_funds | failed
  failureReason String? @map("failure_reason")
  walletTransactionId String? @map("wallet_transaction_id")
  creditedTo    String?  @map("credited_to") // admin user id the ₦500 is credited to
  companyLedgerId String? @map("company_ledger_id")
  // Paystack where applicable: reference is null because settlement is
  // internal (platform wallet); kept for future external-transfer support.
  paystackReference String? @map("paystack_reference")
  paystackStatus    String? @map("paystack_status")
  collectedAt DateTime @default(now()) @map("collected_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, billingMonth])
  @@index([billingMonth, status])
  @@index([status])
  @@index([userId])
  @@map("service_charges")
}

// In-app notification. Two shapes share one table:
//  1. Direct user notifications (system/service-charge messages) — `userId` set.
//  2. Admin broadcast messages — `userId` null, `recipientType`/`recipientIds`
//     describe targeting, and per-user read/dismiss state lives in
//     `NotificationReceipt`.
model Notification {
  id             String    @id @default(cuid())
  userId         String?   @map("user_id") // set for direct (system/service-charge) notifications
  title          String
  body           String
  type           String    @default("info") // info | success | error — severity (existing UI)
  category       String?   @map("category") // announcement | system | reminder | promotion | alert
  senderId       String?   @map("sender_id") // admin who created/sent it
  recipientType  String?   @map("recipient_type") // all | role | selected | specific | null(direct)
  recipientIds   Json?     @map("recipient_ids") // array of user ids for selected/specific
  recipientRole  String?   @map("recipient_role") // role target for role-based sends
  recipientCount Int       @default(0) @map("recipient_count") // resolved recipients at send time
  status         String    @default("sent") // scheduled | sent | failed | cancelled
  scheduledAt    DateTime? @map("scheduled_at")
  sentAt         DateTime? @map("sent_at")
  pushStatus     String?   @map("push_status") // pending | sent | failed | not_configured (future push)
  readAt         DateTime? @map("read_at") // direct-user read mark (broadcast uses receipts)
  dismissedAt    DateTime? @map("dismissed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user     User?  @relation("DirectUserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  sender   User?  @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)
  receipts NotificationReceipt[]

  @@index([userId])
  @@index([senderId])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
  @@map("notifications")
}

// Per-recipient read/dismiss/delivery state for broadcast notifications.
model NotificationReceipt {
  id             String    @id @default(cuid())
  notificationId String    @map("notification_id")
  userId         String    @map("user_id")
  readAt         DateTime? @map("read_at")
  dismissedAt    DateTime? @map("dismissed_at")
  deliveredAt    DateTime? @map("delivered_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
  @@index([notificationId])
  @@map("notification_receipts")
}
