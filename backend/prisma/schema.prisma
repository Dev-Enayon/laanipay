// LaaniPay Ecosystem — Prisma schema
// Database: Neon (serverless Postgres) via pooled connection string (DATABASE_URL).
// Driver adapter: @prisma/adapter-neon (see src/lib/prisma.js).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  fullName         String   @map("full_name")
  email            String   @unique
  phone            String
  passwordHash     String   @map("password_hash")
  activationStatus         Boolean   @default(false) @map("activation_status")
  referralCode             String    @unique @default(cuid()) @map("referral_code")
  emailVerifiedAt          DateTime? @map("email_verified_at")
  verificationToken        String?   @unique @map("verification_token")
  verificationTokenExpiry  DateTime? @map("verification_token_expiry")
  role                     String    @default("user")
  status                   String    @default("active")
  suspendedAt              DateTime? @map("suspended_at")
  suspendedBy              String?   @map("suspended_by")
  suspendedReason          String?   @map("suspended_reason")
  reactivatedAt            DateTime? @map("reactivated_at")
  reactivatedBy            String?   @map("reactivated_by")
  lastActivityAt           DateTime? @map("last_activity_at")
  createdAt                DateTime  @default(now()) @map("created_at")

  wallet                   Wallet?
  activationPayments       ActivationPayment[]
  downline                 MlmReferral[] @relation("Referrer")
  placement                MlmReferral[] @relation("ReferredUser")
  mlmRanks                 MlmRank[]
  contributionSubscriptions ContributionSubscription[]
  cohortMemberships        CohortMember[]
  receivedPayouts          Payout[]
  referralRewards          ReferralReward[] @relation("RewardRecipient")
  referralRewardsGiven     ReferralReward[] @relation("RewardSource")
  auditLogs                AuditLog[] @relation("UserLogs")
  adminLogs                AuditLog[] @relation("AdminActions")
  targetLogs               AuditLog[] @relation("TargetedUser")
  walletTransactions       WalletTransaction[]
  withdrawals              Withdrawal[]
  companyLedger            CompanyLedger[]
  serviceCharges           ServiceCharge[]
  notifications            Notification[] @relation("DirectUserNotifications")
  sentNotifications        Notification[] @relation("SentNotifications")
  notificationReceipts     NotificationReceipt[]

  @@index([status])
  @@map("users")
}

model Wallet {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  balance          Int      @default(0)
  heldBalance      Int      @default(0) @map("held_balance")
  totalContributed Int      @default(0) @map("total_contributed")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model ActivationPayment {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  paystackReference String   @unique @map("paystack_reference")
  amount           Int
  status           String    @default("pending")
  verifiedAt       DateTime? @map("verified_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("activation_payments")
}

model MlmReferral {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  referrerId  String?  @map("referrer_id")
  level       Int
  bonusEarned Int      @default(0) @map("bonus_earned")
  createdAt   DateTime @default(now()) @map("created_at")

  user     User  @relation("ReferredUser", fields: [userId], references: [id], onDelete: Cascade)
  referrer User? @relation("Referrer", fields: [referrerId], references: [id], onDelete: SetNull)

  @@unique([userId, referrerId, level])
  @@index([referrerId])
  @@index([userId])
  @@map("mlm_referrals")
}

model MlmRank {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  rank       String
  achievedAt DateTime @default(now()) @map("achieved_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mlm_ranks")
}

model ContributionPlan {
  id            String   @id @default(cuid())
  name          String
  // MONTHLY plans are billed/paid by their monthly_amount (the original,
  // preserved model). WEEKLY plans are the added AJO frequency and use
  // weekly_amount + cycleWeeks. Each frequency occupies its own amount column;
  // the other column is NULL (no repurposing of monthly_amount for weekly).
  frequency     String   @default("MONTHLY") // MONTHLY | WEEKLY
  monthlyAmount Int?     @map("monthly_amount")
  weeklyAmount  Int?     @map("weekly_amount")
  cycleWeeks    Int      @default(52) @map("cycle_weeks")
  createdAt     DateTime @default(now()) @map("created_at")

  subscriptions ContributionSubscription[]
  cohorts        Cohort[]
  payouts        Payout[]

  @@unique([name, frequency])
  @@index([frequency])
  @@map("contribution_plans")
}

model ContributionSubscription {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  planId          String   @map("plan_id")
  cohortId        String?  @map("cohort_id")
  status          String   @default("active")
  // Snapshot of the amount owed per contribution period, captured when the
  // subscription is created (and backfilled for existing subscriptions when
  // monthly tiers change). Payment amount = `amountKobo ?? planAmount(plan)`,
  // so a pre-existing subscription keeps its original financial terms even if
  // the plan's tier is later updated. Weekly subscriptions carry their
  // weekly_amount here; the weekly amounts are unchanged by tier updates.
  amountKobo      Int?     @map("amount_kobo")
  nextPaymentDate DateTime @map("next_payment_date")
  createdAt       DateTime @default(now()) @map("created_at")

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     ContributionPlan      @relation(fields: [planId], references: [id])
  cohort   Cohort?               @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  payments ContributionPayment[]

  @@index([userId])
  @@map("contribution_subscriptions")
}

model ContributionPayment {
  id                String    @id @default(cuid())
  subscriptionId    String    @map("subscription_id")
  paystackReference String    @unique @map("paystack_reference")
  amount            Int
  status            String    @default("pending")
  weekIndex         Int?      @map("week_index")
  cohortId          String?   @map("cohort_id")
  paidAt            DateTime? @map("paid_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  subscription ContributionSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("contribution_payments")
}

// Platform configuration — admin-editable key/value store used for financial
// rules (fees, rewards, cohort size, etc.). Values are stored as JSON so they
// can be tuned at runtime without deploys.
model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json?
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("platform_settings")
}

// 3-level referral reward ledger. One row per (recipient, level, source).
// The sum of rewards for a source never exceeds its payment amount — whatever
// is left over is implicitly company revenue. `reference` is unique so a
// repeated credit (webhook retry, scheduler re-run) can never double-pay.
model ReferralReward {
  id           String    @id @default(cuid())
  type         String    // REGISTRATION | MONTHLY_SUBSCRIPTION | WEEKLY_CONTRIBUTION
  userId       String    @map("user_id") // reward recipient (upline)
  sourceUserId String    @map("source_user_id") // user whose payment earned the reward
  level        Int
  amountKobo   Int       @map("amount_kobo")
  reference    String    @unique
  status       String    @default("earned") // earned | paid
  createdAt    DateTime  @default(now()) @map("created_at")
  paidAt       DateTime? @map("paid_at")

  user       User @relation("RewardRecipient", fields: [userId], references: [id], onDelete: Cascade)
  sourceUser User @relation("RewardSource", fields: [sourceUserId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sourceUserId, type])
  @@map("referral_rewards")
}

// Weekly AJO (rotating savings) cohort. Exactly `size` positions (default 52).
// New members take the lowest free position; when full the cohort becomes ACTIVE
// and a weekly cycle begins in which position N collects the week N pool.
model Cohort {
  id          String    @id @default(cuid())
  name        String
  planId      String    @map("plan_id")
  size        Int       @default(52)
  status      String    @default("RECRUITING") // RECRUITING | ACTIVE | COMPLETED
  currentWeek Int       @default(1) @map("current_week")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  lastAdvancedAt DateTime? @map("last_advanced_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  plan    ContributionPlan @relation(fields: [planId], references: [id])
  members CohortMember[]
  payouts Payout[]
  subscriptions ContributionSubscription[]

  @@index([planId, status])
  @@map("cohorts")
}

model CohortMember {
  id           String    @id @default(cuid())
  cohortId     String    @map("cohort_id")
  userId       String    @map("user_id")
  position     Int
  status       String    @default("ACTIVE") // ACTIVE | COLLECTED | WAIVED | LEFT
  totalPaid    Int       @default(0) @map("total_paid")
  lastPaidWeek Int?      @map("last_paid_week")
  collectedWeek Int?     @map("collected_week")
  joinedAt     DateTime  @default(now()) @map("joined_at")

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts Payout[]

  @@unique([cohortId, position])
  @@unique([cohortId, userId])
  @@index([userId])
  @@map("cohort_members")
}

// A weekly payout to the week's collector. Unique (cohort, weekIndex) makes
// processing idempotent. `provider` distinguishes internal wallet settlement
// ('internal') from an external bank transfer ('paystack_transfer' / 'manual')
// so the limitation is explicit, not hidden.
model Payout {
  id                String    @id @default(cuid())
  cohortId          String    @map("cohort_id")
  cohortMemberId    String    @map("cohort_member_id")
  userId            String    @map("user_id")
  planId            String    @map("plan_id")
  weekIndex         Int       @map("week_index")
  grossAmount       Int       @map("gross_amount")
  platformFee       Int       @default(0) @map("platform_fee")
  netAmount         Int       @default(0) @map("net_amount")
  status            String    @default("PROCESSING") // PROCESSING | PAID | FAILED | SKIPPED
  provider          String    @default("internal")
  providerReference String?   @map("provider_reference")
  processedAt       DateTime? @map("processed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  cohort       Cohort           @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  cohortMember CohortMember     @relation(fields: [cohortMemberId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         ContributionPlan @relation(fields: [planId], references: [id])

  @@unique([cohortId, weekIndex])
  @@index([userId])
  @@index([status])
  @@map("payouts")
}

// Webhook activity log. Every Paystack event is persisted for audit and
// idempotency; the unique (provider, event, reference) constraint makes retries
// harmless.
model WebhookEvent {
  id        String    @id @default(cuid())
  provider  String    @default("paystack")
  event     String
  reference String?
  status    String    @default("RECEIVED") // RECEIVED | PROCESSED | FAILED | IGNORED
  message   String?
  body      Json?
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([provider, event, reference])
  @@index([reference])
  @@index([createdAt])
  @@map("webhook_events")
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  adminId      String?  @map("admin_id")
  targetUserId String?  @map("target_user_id")
  action       String
  reason       String?
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  user       User? @relation("UserLogs", fields: [userId], references: [id], onDelete: SetNull)
  adminUser  User? @relation("AdminActions", fields: [adminId], references: [id], onDelete: SetNull)
  targetUser User? @relation("TargetedUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([adminId])
  @@index([targetUserId])
  @@map("audit_logs")
}

// Wallet ledger — every credit/debit against a user's wallet (contributions,
// MLM bonuses, manual admin deposits/withdrawals/adjustments).
model WalletTransaction {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  type         String
  amount       Int
  balanceAfter Int      @default(0) @map("balance_after")
  status       String   @default("completed")
  reference    String?
  description  String?
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("wallet_transactions")
}

// Wallet withdrawal requests. Funds are reserved atomically at request time
// (balance -> heldBalance) so a withdrawal can never drive the available
// balance negative. External bank transfers (Paystack) are provider-gated:
// when the provider is disabled a request stays PENDING / PROCESSING and is
// settled through the admin-verified payout flow; SUCCESS is only ever marked
// by an admin verification or a confirmed provider event, never faked.
// `activeLock` (unique, null when inactive) guarantees at most one active
// (PENDING/PROCESSING) withdrawal per user even under concurrency.
model Withdrawal {
  id                       String    @id @default(cuid())
  userId                   String    @map("user_id")
  amountKobo               Int       @map("amount_kobo")
  status                   String    @default("PENDING") // PENDING | PROCESSING | SUCCESS | FAILED | REVERSED | CANCELLED
  provider                 String    @default("internal") // internal | paystack_transfer
  providerReference        String?   @unique @map("provider_reference")
  bankName                 String?   @map("bank_name")
  bankCode                 String?   @map("bank_code")
  accountNumber            String?   @map("account_number")
  accountName              String?   @map("account_name")
  failureReason            String?   @map("failure_reason")
  notes                    String?
  reservedAt               DateTime? @map("reserved_at")
  processedAt              DateTime? @map("processed_at")
  completedAt              DateTime? @map("completed_at")
  cancelledAt              DateTime? @map("cancelled_at")
  walletTransactionId      String?   @unique @map("wallet_transaction_id")
  refundedWalletTransactionId String? @unique @map("refunded_wallet_transaction_id")
  processedByAdminId       String?   @map("processed_by_admin_id")
  activeLock               String?   @unique @map("active_lock")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("withdrawals")
}

// Company ledger — recorded platform expenses and revenue adjustments.
// Used with activation fees and MLM bonuses to compute true company profit.
model CompanyLedger {
  id          String   @id @default(cuid())
  type        String
  amount      Int
  description String?
  adminId     String?  @map("admin_id")
  createdAt   DateTime @default(now()) @map("created_at")

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("company_ledger")
}

// Monthly ₦500 service charge deducted from each eligible user's wallet.
// One row per user per billing month (billingMonth = 'YYYY-MM'), unique
// constraint guarantees a user can never be charged twice for the same month.
model ServiceCharge {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  amountKobo   Int      @map("amount_kobo")
  currency     String   @default("NGN")
  billingMonth String   @map("billing_month") // 'YYYY-MM'
  status       String   @default("collected") // collected | insufficient_funds | failed
  failureReason String? @map("failure_reason")
  walletTransactionId String? @map("wallet_transaction_id")
  creditedTo    String?  @map("credited_to") // admin user id the ₦500 is credited to
  companyLedgerId String? @map("company_ledger_id")
  // Paystack where applicable: reference is null because settlement is
  // internal (platform wallet); kept for future external-transfer support.
  paystackReference String? @map("paystack_reference")
  paystackStatus    String? @map("paystack_status")
  collectedAt DateTime @default(now()) @map("collected_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, billingMonth])
  @@index([billingMonth, status])
  @@index([status])
  @@index([userId])
  @@map("service_charges")
}

// In-app notification. Two shapes share one table:
//  1. Direct user notifications (system/service-charge messages) — `userId` set.
//  2. Admin broadcast messages — `userId` null, `recipientType`/`recipientIds`
//     describe targeting, and per-user read/dismiss state lives in
//     `NotificationReceipt`.
model Notification {
  id             String    @id @default(cuid())
  userId         String?   @map("user_id") // set for direct (system/service-charge) notifications
  title          String
  body           String
  type           String    @default("info") // info | success | error — severity (existing UI)
  category       String?   @map("category") // announcement | system | reminder | promotion | alert
  senderId       String?   @map("sender_id") // admin who created/sent it
  recipientType  String?   @map("recipient_type") // all | role | selected | specific | null(direct)
  recipientIds   Json?     @map("recipient_ids") // array of user ids for selected/specific
  recipientRole  String?   @map("recipient_role") // role target for role-based sends
  recipientCount Int       @default(0) @map("recipient_count") // resolved recipients at send time
  status         String    @default("sent") // scheduled | sent | failed | cancelled
  scheduledAt    DateTime? @map("scheduled_at")
  sentAt         DateTime? @map("sent_at")
  pushStatus     String?   @map("push_status") // pending | sent | failed | not_configured (future push)
  readAt         DateTime? @map("read_at") // direct-user read mark (broadcast uses receipts)
  dismissedAt    DateTime? @map("dismissed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user     User?  @relation("DirectUserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  sender   User?  @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)
  receipts NotificationReceipt[]

  @@index([userId])
  @@index([senderId])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
  @@map("notifications")
}

// Per-recipient read/dismiss/delivery state for broadcast notifications.
model NotificationReceipt {
  id             String    @id @default(cuid())
  notificationId String    @map("notification_id")
  userId         String    @map("user_id")
  readAt         DateTime? @map("read_at")
  dismissedAt    DateTime? @map("dismissed_at")
  deliveredAt    DateTime? @map("delivered_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
  @@index([notificationId])
  @@map("notification_receipts")
}
