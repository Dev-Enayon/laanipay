# LaaniPay API — environment variables
# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=5000

# Neon Postgres (serverless). Use the POOLED connection string
# (ends with -pooler.neon.tech) — required for the Neon driver adapter.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT secrets — generate strong random values (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# Paystack — SERVER-SIDE ONLY credential. Never expose to the frontend.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Allowed frontend origin(s) for CORS (comma separated).
CLIENT_ORIGIN=http://localhost:5173

# Resend email — transactional mail (verification, receipts, notifications).
# Get a key at https://resend.com/api-keys. Without it, emails are skipped.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Sender address. On the free/testing plan use "LaaniPay <onboarding@resend.dev>".
# Once you verify your own domain you can send from e.g. "LaaniPay <no-reply@laanipay.ng>".
MAIL_FROM=LaaniPay <onboarding@resend.dev>
# Optional reply-to address (e.g. your support inbox).
MAIL_REPLY_TO=laanipay@gmail.com
# Public frontend URL used in email links (verification links etc.).
FRONTEND_URL=http://localhost:5173
