# LaaniPay API — environment variables
# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=5000

# Neon Postgres (serverless). Use the POOLED connection string
# (ends with -pooler.neon.tech) — required for the Neon driver adapter.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT secrets — generate strong random values (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# Paystack — SERVER-SIDE ONLY credential. Never expose to the frontend.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Allowed frontend origin(s) for CORS (comma separated).
CLIENT_ORIGIN=http://localhost:5173
